DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=5432

SECRET_KEY=your_django_secret_key
DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Channel layer (memory = no Redis, redis = requires Redis running)
CHANNEL_BACKEND=memory

# Redis — only needed when CHANNEL_BACKEND=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# DB_HOST: localhost/127.0.0.1 = local PostgreSQL, aws-...supabase.com = Supabase
# IS_LOCAL_DB is auto-detected from DB_HOST
